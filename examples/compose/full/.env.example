# Copy to .env and edit.  cp .env.example .env

# Required. Base URL of your Vikunja instance, WITHOUT the /api/v2 suffix.
VIKUNJA_URL=https://vikunja.example.com

# Optional. Project a bare "#12" ticket reference resolves within. Leave empty and an
# ambiguous reference raises rather than guessing.
VIKUNJA_DEFAULT_PROJECT_ID=

# Optional. Comma-separated task ids excluded from every backlog_summary bucket.
VIKUNJA_SUMMARY_EXCLUDE_IDS=

# NOTE: there is deliberately no VIKUNJA_TOKEN here. On the HTTP transport a static token
# is refused at startup — callers send their own bearer per request.
